{
  "name": "videoreferee",
  "version": "0.0.17",
  "private": true,
  "type": "module",
  "description": "Referee support tool: simultaneous multi-angle video of a bout, bookmarked and reviewed side by side.",
  "license": "GPL-3.0",
  "scripts": {
    "start": "tsx tools/start.ts",
    "start:hub": "tsx src/hub/server.ts",
    "gen-cert": "tsx tools/gen-cert.ts",
    "build:operator": "npm --prefix web/operator install && npm --prefix web/operator run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@angular/cli": "^21.2.20",
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.62.1",
    "selfsigned": "^5.5.0",
    "tsx": "^4.23.10",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.21.2"
  }
}
